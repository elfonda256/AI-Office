# ==========================================
# 🏢 KANTOR AI - ENVIRONMENT VARIABLES
# ==========================================

# 1. Kunci API Google Gemini (Wajib untuk AI Agen)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan (Hemat & Cepat)
GEMINI_MODEL=gemini-3.5-flash-lite

# Model Cadangan jika Model Utama terkena batas kuota / limit
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# 2. Password Pengaman Kantor AI (Opsional tapi Direkomendasikan)
# Lindungi kantor dan kuota API Anda dari penggunaan orang lain
APP_PASSWORD=kantor123

# 3. Database Cloud Turso (Wajib untuk Vercel)
# Dapatkan gratis di: https://turso.tech
# URL database Turso (contoh: libsql://kantor-db-username.turso.io)
TURSO_DATABASE_URL=
# Auth token database Turso
TURSO_AUTH_TOKEN=

# 4. Notifikasi Bot Telegram (Opsional)
# Dapatkan Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=
# Dapatkan Chat ID dari @userinfobot di Telegram
TELEGRAM_CHAT_ID=

# 5. URL Web App (Untuk link tombol di notifikasi Telegram)
# Contoh: https://ai-office-xxx.vercel.app atau http://localhost:3000
APP_URL=
